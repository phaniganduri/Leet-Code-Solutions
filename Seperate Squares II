You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
Answers within 10⁻⁵ of the actual answer will be accepted.Squares may overlap. Overlapping areas should be counted only once in this version.
Example 1:
Input:
squares = [[0,0,1],[2,2,1]]
Output:
1.00000
Example 2:
Input:
squares = [[0,0,2],[1,1,1]]
Output:
1.00000

Time Complexity:
O(N log N) – due to sweep line and segment tree operations.
Space Complexity:
O(N) – for events, coordinate compression, and segment tree



package com.solutions;
import java.util.*;
public class SeperateSquaresII {
    // ---------- EVENT CLASS ----------
    static class Event {
        double y;
        double x1, x2;
        int type; // +1 = add, -1 = remove

        Event(double y, double x1, double x2, int type) {
            this.y = y;
            this.x1 = x1;
            this.x2 = x2;
            this.type = type;
        }
    }

    // ---------- SEGMENT TREE ----------
    static class SegmentTree {
        int n;
        double[] xs;
        int[] count;
        double[] length;

        SegmentTree(double[] xs) {
            this.xs = xs;
            this.n = xs.length - 1;
            count = new int[4 * n];
            length = new double[4 * n];
        }

        void update(int node, int l, int r, int ql, int qr, int val) {
            if (ql > r || qr < l) return;

            if (ql <= l && r <= qr) {
                count[node] += val;
            } else {
                int mid = (l + r) / 2;
                update(node * 2, l, mid, ql, qr, val);
                update(node * 2 + 1, mid + 1, r, ql, qr, val);
            }

            if (count[node] > 0) {
                length[node] = xs[r + 1] - xs[l];
            } else if (l == r) {
                length[node] = 0;
            } else {
                length[node] = length[node * 2] + length[node * 2 + 1];
            }
        }

        double queryTotalLength() {
            return length[1];
        }
    }

    // ---------- MAIN FUNCTION ----------
    public static void main(String[] args) {

        int[][] squares1 = {{0, 0, 1}, {2, 2, 1}};
        int[][] squares2 = {{0, 0, 2}, {1, 1, 1}};

        System.out.printf("Output 1: %.5f%n", separateSquares(squares1));
        System.out.printf("Output 2: %.5f%n", separateSquares(squares2));
    }

    public static double separateSquares(int[][] squares) {

        double low = 1e18, high = -1e18;
        for (int[] s : squares) {
            low = Math.min(low, s[1]);
            high = Math.max(high, s[1] + s[2]);
        }

        double total = unionAreaUpTo(squares, high);
        double target = total / 2.0;

        for (int i = 0; i < 60; i++) {
            double mid = (low + high) / 2;
            if (unionAreaUpTo(squares, mid) < target) low = mid;
            else high = mid;
        }

        return low;
    }

    // ---------- UNION AREA BELOW Y ----------
    static double unionAreaUpTo(int[][] squares, double limitY) {

        List<Event> events = new ArrayList<>();
        Set<Double> xSet = new HashSet<>();

        for (int[] s : squares) {
            double x1 = s[0];
            double y1 = s[1];
            double l = s[2];
            double x2 = x1 + l;
            double y2 = y1 + l;

            if (y1 >= limitY) continue;

            double bottom = y1;
            double top = Math.min(y2, limitY);

            events.add(new Event(bottom, x1, x2, 1));
            events.add(new Event(top, x1, x2, -1));

            xSet.add(x1);
            xSet.add(x2);
        }

        if (events.isEmpty()) return 0;

        double[] xs = xSet.stream().sorted().mapToDouble(Double::doubleValue).toArray();
        Map<Double, Integer> map = new HashMap<>();
        for (int i = 0; i < xs.length; i++) map.put(xs[i], i);

        events.sort(Comparator.comparingDouble(e -> e.y));

        SegmentTree st = new SegmentTree(xs);

        double area = 0;
        double prevY = events.get(0).y;

        for (Event e : events) {
            double curY = e.y;
            double coveredX = st.queryTotalLength();
            area += coveredX * (curY - prevY);

            int l = map.get(e.x1);
            int r = map.get(e.x2) - 1;
            if (l <= r)
                st.update(1, 0, st.n - 1, l, r, e.type);

            prevY = curY;
        }

        return area;
    }
}
