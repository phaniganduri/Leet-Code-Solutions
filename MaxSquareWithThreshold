Given a m x n matrix mat and an integer threshold, return the maximum side-length of a square with a sum less than or equal to threshold or return 0 if there is no such square.
Example 1: Input: mat = [[1,1,3,2,4,3,2],[1,1,3,2,4,3,2],[1,1,3,2,4,3,2]], threshold = 4 Output: 2 
Explanation: The maximum side length of square with sum less than 4 is 2 as shown.
Example 2: Input: mat = [[2,2,2,2,2],[2,2,2,2,2],[2,2,2,2,2],[2,2,2,2,2],[2,2,2,2,2]], threshold = 1 Output: 0
Constraints: 
m == mat.length
n == mat[i].length 
1 <= m, n <= 300 
0 <= mat[i][j] <= 104 
0 <= threshold <= 105

package com.solutions;
public class MaxSquareWithThreshold {

    public static void main(String[] args) {

        // -------- Test Case 1 --------
        int[][] mat1 = {
            {1, 1, 3, 2, 4, 3, 2},
            {1, 1, 3, 2, 4, 3, 2},
            {1, 1, 3, 2, 4, 3, 2}
        };
        int threshold1 = 4;

        int result1 = maxSideLength(mat1, threshold1);
        System.out.println("Output 1: " + result1); // Expected: 2


        // -------- Test Case 2 --------
        int[][] mat2 = {
            {2, 2, 2, 2, 2},
            {2, 2, 2, 2, 2},
            {2, 2, 2, 2, 2},
            {2, 2, 2, 2, 2},
            {2, 2, 2, 2, 2}
        };
        int threshold2 = 1;

        int result2 = maxSideLength(mat2, threshold2);
        System.out.println("Output 2: " + result2); // Expected: 0
    }

    public static int maxSideLength(int[][] mat, int threshold) {
        int m = mat.length;
        int n = mat[0].length;

        int[][] pre = new int[m + 1][n + 1];

        // Build prefix sum
        for (int i = 1; i <= m; i++) {
            for (int j = 1; j <= n; j++) {
                pre[i][j] = mat[i - 1][j - 1]
                          + pre[i - 1][j]
                          + pre[i][j - 1]
                          - pre[i - 1][j - 1];
            }
        }

        int low = 0, high = Math.min(m, n), ans = 0;

        while (low <= high) {
            int mid = (low + high) / 2;

            if (existsSquare(pre, mid, threshold)) {
                ans = mid;
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        return ans;
    }

    private static boolean existsSquare(int[][] pre, int len, int threshold) {
        if (len == 0) return true;

        for (int i = len; i < pre.length; i++) {
            for (int j = len; j < pre[0].length; j++) {

                int sum = pre[i][j]
                        - pre[i - len][j]
                        - pre[i][j - len]
                        + pre[i - len][j - len];

                if (sum <= threshold) return true;
            }
        }
        return false;
    }
}
